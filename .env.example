# Ключ ProxyAPI: https://console.proxyapi.ru/keys
PROXYAPI_KEY=your-proxyapi-key-here

# OpenAI-совместимый API ProxyAPI (универсальный шлюз)
OPENAI_BASE_URL=https://openai.api.proxyapi.ru/v1

# Модель в формате <провайдер>/<название> (см. https://proxyapi.ru/docs/openai-compatible-api)
MODEL_NAME=openai/gpt-4o-mini

# Температура генерации (0.0–1.0)
TEMPERATURE=0.2
